# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment (large, machine-specific - recreate with build/requirements.txt)
venv/

# Build outputs (regenerated by build/build_installer.py / build/build.ps1)
build/dist/
build/pyinstaller-work/
build/pyinstaller_work/
build/installer_dist/
*.spec

# Installer binary - ships as a GitHub Release asset, never committed to the repo
*.exe

# User data - generated at runtime, machine-specific, must not be committed
data/
Meetings/

# Logs
*.log

# Local tooling state, not part of the shipped product
.claude/
SPEC.md
CHANGELOG.md
PROJECT.md
RELEASE-CHECKLIST.md
DELETIONS.md
