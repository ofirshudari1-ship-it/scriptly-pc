; ============================================================================
; Scriptly PC - Windows Installer (Inno Setup 6)
; ============================================================================
; MyAppVersion must match version.json at the project root - both are updated
; together on every release (see build/build.ps1, which injects it here via /D).
; AppId is permanent forever - Windows uses it to tell "update" from "new install".
; ============================================================================

#define MyAppName "Scriptly PC"
#ifndef MyAppVersion
  #define MyAppVersion "0.12.1"
#endif
#define MyAppPublisher "Scriptly PC"
#define MyAppExeName "Scriptly PC.exe"
#define MyDistDir "..\..\dist\Scriptly PC"
; Must match app/single_instance.py's _MUTEX_NAME exactly (including the
; Global\ namespace prefix the app uses) or the installer's running-check
; below would silently never trigger.
#define MyAppMutex "Global\ScriptlyPC_SingleInstance_Mutex"

[Setup]
AppId={{7E2B9C2E-6B7B-4F1A-9C3E-1F1E2B2A9A11}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL=https://scriptly.local
AppSupportURL=https://scriptly.local
AppUpdatesURL=https://scriptly.local
AppMutex={#MyAppMutex}

; Program Files by default; falls back to per-user if the installer can't get
; admin rights, instead of failing outright.
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=no
AllowNoIcons=no
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UsePreviousAppDir=yes

; Output - final installer ships from the project ROOT, not a build subfolder.
OutputDir=..\..
OutputBaseFilename=Scriptly-PC-Setup-{#MyAppVersion}
SetupIconFile=..\..\assets\icon_idle.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
VersionInfoVersion={#MyAppVersion}

; Same brand identity (navy/teal, same soundwave+checkmark mark) as the app
; itself, the tray icon, and assets/BRAND.md - not Inno's generic grey
; wizard. Generated by build/generate_installer_banner.py.
WizardImageFile=..\..\assets\installer_wizard.bmp
WizardSmallImageFile=..\..\assets\installer_wizard_small.bmp

; Short EULA (build/EULA.txt) - optional per the standard, included anyway
; since the installer is unsigned (higher user risk without it).
LicenseFile=..\EULA.txt

Compression=lzma2
SolidCompression=yes
InternalCompressLevel=ultra
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=6.2

; Language dialog always shown - it is the very first screen per standard.
ShowLanguageDialog=yes
WizardStyle=modern

; Closes the app automatically if it's running and the user agrees (belt and
; braces alongside the explicit mutex check in [Code] below, which gives a
; clearer bilingual message before Inno's own generic one would appear).
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "hebrew"; MessagesFile: "compiler:Languages\Hebrew.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "quicklaunch"; Description: "{cm:TaskQuickLaunch}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart"; Description: "{cm:TaskAutostart}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#MyDistDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; Docs shipped alongside the exe so the in-app "View Changelog" (About screen)
; and troubleshooting steps in README.md are available offline, not just in
; the source repo.
Source: "..\..\CHANGELOG.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\README.md"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; Comment: "{cm:AppComment}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; Tasks: desktopicon
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: quicklaunch

[Registry]
; uninsdeletevalue/uninsdeletekeyifempty: without these flags, Inno Setup does
; NOT remove [Registry] entries on uninstall by default - they'd be the classic
; leftover that makes a "clean" uninstall not actually clean (STANDARDS.md 11.5).
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueName: "{#MyAppName}"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"""; Tasks: autostart; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\{#MyAppPublisher}"; ValueName: "InstallLocation"; ValueType: string; ValueData: "{app}"; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\{#MyAppPublisher}"; ValueName: "Version"; ValueType: string; ValueData: "{#MyAppVersion}"; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\{#MyAppPublisher}"; Flags: uninsdeletekeyifempty

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent

[UninstallDelete]
; Nothing forced here on purpose - data/config.json and Meetings/ are only
; removed if the user explicitly says yes to the prompt in [Code] below.

[CustomMessages]
english.TaskQuickLaunch=Add Scriptly PC to taskbar
english.TaskAutostart=Start Scriptly PC automatically when Windows starts
english.AppComment=Record, transcribe, and manage meeting notes
english.AlreadyRunningTitle=Scriptly PC is running
english.AlreadyRunningBody=Scriptly PC is currently running. Please close it before continuing, then click Retry.%n%nIf you can't find it, look for its icon near the clock (it may be hidden in the overflow tray icons).
english.DeleteDataPrompt=Do you also want to delete your recordings and settings?%n%nThis includes everything under the Meetings folder and data\config.json. This cannot be undone.

hebrew.TaskQuickLaunch=הוספת Scriptly PC לשורת המשימות
hebrew.TaskAutostart=הפעלה אוטומטית של Scriptly PC עם הפעלת Windows
hebrew.AppComment=הקלטה, תמלול וניהול סיכומי פגישות
hebrew.AlreadyRunningTitle=Scriptly PC פועל כרגע
hebrew.AlreadyRunningBody=Scriptly PC פועל כרגע. יש לסגור אותו לפני שממשיכים, ואז ללחוץ על נסה שוב.%n%nאם אינך מוצא אותו, חפש את האייקון ליד השעון (יתכן שהוא מוסתר באייקונים החבויים).
hebrew.DeleteDataPrompt=האם למחוק גם את ההקלטות וההגדרות שלך?%n%nזה כולל את כל תיקיית Meetings ואת data\config.json. לא ניתן לבטל פעולה זו.

[Messages]
; Appends a copyright line just above the Finish button (STANDARDS.md section 7:
; "the finish screen includes a copyright line") without fighting Inno's own
; [name]/[icons] placeholder logic inside FinishedLabel itself.
english.ClickFinish=%n(c) 2026 Scriptly PC. All rights reserved.%n%nClick Finish to exit Setup.
hebrew.ClickFinish=%n(c) 2026 Scriptly PC. כל הזכויות שמורות.%n%nלחץ על סיום כדי לצאת מההתקנה.

[Code]
{ ---------------------------------------------------------------------------
  Running-instance guard: AppMutex above already makes Inno offer to close
  the app automatically (CloseApplications=yes), but on a locked-down machine
  or if that silent close fails, this gives a clear bilingual explanation
  instead of a generic Windows error, with Retry/Cancel instead of a dead end.
  --------------------------------------------------------------------------- }
function InitializeSetup(): Boolean;
begin
  Result := True;
  while CheckForMutexes('{#MyAppMutex}') do
  begin
    if MsgBox(ExpandConstant('{cm:AlreadyRunningBody}'), mbError, MB_RETRYCANCEL) = IDCANCEL then
    begin
      Result := False;
      Exit;
    end;
  end;
end;

{ ---------------------------------------------------------------------------
  Clean uninstall: ask whether to also remove user data, default = No.
  --------------------------------------------------------------------------- }
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{app}');
    if MsgBox(ExpandConstant('{cm:DeleteDataPrompt}'), mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
    begin
      DelTree(DataDir + '\data', True, True, True);
      DelTree(DataDir + '\Meetings', True, True, True);
    end;
  end;
end;
